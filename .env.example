# =====================================================================
#  KI-Anrufer
#  Nichts eingetragen  -> geskriptete Anrufer (funktioniert immer, gratis)
#  OPENAI_API_KEY      -> OpenAI (Standardmodell siehe LLM_MODEL)
#  LLM_BASE_URL        -> eigener OpenAI-kompatibler Endpunkt (LiteLLM, Ollama, ...)
#  Der Key bleibt immer auf dem Server, nie im Browser.
# =====================================================================

# Einfachster Weg: nur den OpenAI-Key eintragen.
OPENAI_API_KEY=

# Optional: Modell (Standard: gpt-4o-mini).
LLM_MODEL=

# Optional: eigener Endpunkt statt OpenAI, Adresse vor /chat/completions,
# z. B. http://localhost:4000/v1 fuer LiteLLM. Dann gilt LLM_API_KEY (falls noetig).
LLM_BASE_URL=
LLM_API_KEY=

LLM_TEMPERATURE=0.9
LLM_TIMEOUT_MS=15000

# ---- Rate-Limit pro Raum ----
# KI-Antworten pro Minute und Raum; darueber antworten die Skript-Anrufer.
RATE_LIMIT_PER_MINUTE=20
# KI-Antworten insgesamt pro Raum.
RATE_LIMIT_PER_ROOM=400

# ---- Server ----
PORT=8787
# Seiten, die den Server nutzen duerfen (Komma-getrennt, * als Platzhalter).
ALLOWED_ORIGINS=https://*.playtoki.app,https://playtoki.app,https://toki-ashy.vercel.app,http://localhost:*,http://127.0.0.1:*

# ---- Client ----
# Adresse des Spielservers fuer den Build (lokal: http://127.0.0.1:8787).
VITE_SERVER_URL=http://127.0.0.1:8787
